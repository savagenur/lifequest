// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// USER MODEL
// ============================================
// The player of LifeQuest. Stores their profile, XP, and level.
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?   // Hashed password for credentials auth
  image         String?
  xp            Int       @default(0)
  level         Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Streak tracking
  currentStreak   Int       @default(0)      // Current consecutive days with completed quests
  longestStreak   Int       @default(0)      // Longest streak achieved
  lastActiveDate  DateTime?                 // Last date user completed a quest

  // Auth relationships
  accounts Account[]
  sessions Session[]

  // App relationships
  avatar            Avatar?           // One user has one avatar (optional)
  quests            Quest[]           // One user can create many quests
  questCompletions  QuestCompletion[] // One user can have many completions
  coachProfile      CoachProfile?     // AI Coach preferences
  dailyQuestBatches DailyQuestBatch[] // AI-generated daily quests
  userBadges        UserBadge[]       // Badges user has earned
  goals             Goal[]            // User's progress goals

  @@map("users") // Table name in PostgreSQL
}

// ============================================
// AUTH MODELS (NextAuth.js / Auth.js)
// ============================================
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
  @@map("password_reset_tokens")
}

// ============================================
// AVATAR MODEL
// ============================================
// The user's visual representation in the game.
// Separate from User to keep concerns clean and allow future expansion.
model Avatar {
  id        String   @id @default(cuid())
  imageUrl  String?
  style     String   @default("default")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationship: One avatar belongs to one user
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("avatars")
}

// ============================================
// QUEST MODEL
// ============================================
// A task or goal the user wants to complete.
// Think of it as a "mission" in a video game.
model Quest {
  id          String      @id @default(cuid())
  title       String
  description String?
  xpReward    Int         @default(10)
  difficulty  Difficulty  @default(EASY)
  category    Category    @default(PERSONAL)
  isRecurring Boolean     @default(false)
  status      QuestStatus @default(ACTIVE)
  dueDate     DateTime?
  scheduledDate DateTime? // The date this quest is scheduled for (separate from createdAt for timezone handling)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relationship: One quest belongs to one user
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationship: One quest can have many completions (for recurring quests)
  completions QuestCompletion[]
  
  // If this quest was created from an AI suggestion
  aiQuest     AIQuest?

  @@index([userId]) // Index for faster queries by user
  @@map("quests")
}

// ============================================
// QUEST COMPLETION MODEL
// ============================================
// Records each time a quest is completed.
// Separate from Quest to track history and support recurring quests.
model QuestCompletion {
  id          String   @id @default(cuid())
  completedAt DateTime @default(now())
  xpEarned    Int

  // Relationships
  questId String
  quest   Quest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([questId])
  @@map("quest_completions")
}

// ============================================
// ENUMS
// ============================================
// Enums are fixed sets of values. They make your data more predictable.

enum Difficulty {
  EASY   // 10 XP base
  MEDIUM // 25 XP base
  HARD   // 50 XP base
  EPIC   // 100 XP base
}

enum Category {
  HEALTH    // Exercise, diet, sleep
  LEARNING  // Reading, courses, skills
  CAREER    // Work tasks, networking
  PERSONAL  // Hobbies, relationships
  FINANCE   // Budgeting, saving
}

enum QuestStatus {
  ACTIVE    // Quest is in progress
  COMPLETED // Quest is done
  ABANDONED // User gave up on quest
}

// ============================================
// AI COACH MODELS
// ============================================

// User's preferences and goals for AI-generated quests
model CoachProfile {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // What areas the user wants to focus on (stored as JSON array)
  focusAreas    Category[] // e.g., [HEALTH, LEARNING]
  
  // User's self-described challenges
  challenges    String?    // Free text: "I procrastinate", "No exercise routine"
  
  // How much time they have daily (in minutes)
  dailyTimeMinutes Int @default(60)
  
  // Preferred intensity
  intensity     CoachIntensity @default(BALANCED)
  
  // Coach personality style
  coachStyle    CoachStyle @default(MOTIVATIONAL)
  
  // Has completed onboarding?
  onboardingComplete Boolean @default(false)

  // Relationship
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("coach_profiles")
}

// Daily AI-generated quest batch
model DailyQuestBatch {
  id          String   @id @default(cuid())
  date        DateTime @db.Date // The date this batch is for
  createdAt   DateTime @default(now())
  
  // AI-generated motivation message for the day
  motivation  String?
  
  // How many times user has regenerated quests (max 2 allowed)
  regenerationCount Int @default(0)
  
  // The quests generated for this day
  quests      AIQuest[]
  
  // Relationship
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date]) // One batch per user per day
  @@index([userId])
  @@map("daily_quest_batches")
}

// Individual AI-generated quest (linked to regular Quest when accepted)
model AIQuest {
  id          String   @id @default(cuid())
  title       String
  description String
  reason      String   // Why the AI suggested this quest
  xpReward    Int
  difficulty  Difficulty
  category    Category
  
  // Status of the AI suggestion
  status      AIQuestStatus @default(PENDING)
  
  // If accepted, links to the actual Quest
  questId     String?  @unique
  quest       Quest?   @relation(fields: [questId], references: [id])
  
  // Relationship to batch
  batchId     String
  batch       DailyQuestBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@map("ai_quests")
}

enum CoachIntensity {
  GENTLE    // 2-3 easy quests, lots of encouragement
  BALANCED  // 3-4 mixed difficulty quests
  INTENSE   // 4-5 challenging quests, push limits
}

enum CoachStyle {
  MOTIVATIONAL  // "You've got this! Let's crush it!"
  ANALYTICAL    // "Based on your patterns, I recommend..."
  FRIENDLY      // "Hey! How about we try this today?"
  DRILL_SERGEANT // "No excuses. Get it done."
}

enum AIQuestStatus {
  PENDING   // Suggested, not yet acted on
  ACCEPTED  // User accepted, Quest created
  SKIPPED   // User skipped this suggestion
  EXPIRED   // Day passed without action
}

// ============================================
// BADGE SYSTEM MODELS
// ============================================

// Badge definitions (achievements users can earn)
model Badge {
  id          String   @id @default(cuid())
  name        String   // Display name
  description String   // What this badge represents
  icon        String   // Emoji or icon for the badge
  category    BadgeCategory
  requirement String  // How to earn this badge (e.g., "Complete 10 health quests")
  rarity      BadgeRarity @default(COMMON)
  createdAt   DateTime @default(now())

  // Which users have earned this badge
  userBadges  UserBadge[]

  @@index([category])
  @@map("badges")
}

// Join table for users and badges
model UserBadge {
  id        String   @id @default(cuid())
  earnedAt  DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

enum BadgeCategory {
  QUEST_COUNT      // Total quests completed
  CATEGORY          // Category-specific achievements
  DIFFICULTY        // Difficulty-specific achievements
  STREAK            // Streak-based achievements
  LEVEL             // Level-based achievements
  TIME              // Time-based achievements
  SPECIAL           // Special/limited achievements
}

enum BadgeRarity {
  COMMON    // Easy to earn
  RARE      // Moderate difficulty
  EPIC      // Hard to earn
  LEGENDARY // Very rare achievements
}

// ============================================
// GOAL SYSTEM MODELS
// ============================================

// User's personal progress goals
model Goal {
  id          String   @id @default(cuid())
  title       String   // Goal title
  description String?  // Optional description
  targetValue Int      // Target value (e.g., 500 XP)
  currentValue Int     @default(0) // Current progress
  unit        String   @default("XP") // Unit of measurement
  deadline    DateTime?
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("goals")
}
